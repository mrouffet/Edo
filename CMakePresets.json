{
  "version": 9,
  "configurePresets": [
    {
      "name": "Base",
      "hidden": true,
      "binaryDir": "${sourceDir}/Build/${presetName}",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/Install/${presetName}",
        "EDO_BUILD_TESTS_OPT": true,
        "EDO_TEST_SDL_OPT": false,
        "EDO_TEST_GLFW_OPT": true,
        "EDO_TEST_SFML_OPT": false
      }
    },
    {
      "name": "GCC",
      "inherits": "Base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc$env{gcc_compiler_v}",
        "CMAKE_CXX_COMPILER": "g++$env{gcc_compiler_v}"
      },
      "description": "Compilers: C=gcc, CXX=g++",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "Clang",
      "inherits": "Base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang$env{clang_compiler_v}",
        "CMAKE_CXX_COMPILER": "clang++$env{clang_compiler_v}"
      },
      "description": "Compilers: C=clang, CXX=clang++",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "Visual Studio",
      "hidden": true,
      "inherits": "Base",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "VS_2022",
      "inherits": "Visual Studio",
      "displayName": "Visual Studio 2022",
      "description": "MSVC Compiler 2022",
      "generator": "Visual Studio 17 2022"
    },
    {
      "name": "VS_2022_ClangCL",
      "inherits": "Visual Studio",
      "displayName": "ClangCL Visual Studio 2022",
      "description": "Clang CL Compiler with Visual Studio",
      "generator": "Visual Studio 17 2022",
      "toolset": "ClangCL",
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "windows-clang-x64"
        }
      }
    },
    {
      "name": "VS_2026",
      "inherits": "Visual Studio",
      "displayName": "Visual Studio 2026",
      "description": "MSVC Compiler 2026",
      "generator": "Visual Studio 18 2026"
    },
    {
      "name": "VS_2026_ClangCL",
      "inherits": "Visual Studio",
      "displayName": "ClangCL Visual Studio 2026",
      "description": "Clang CL Compiler with Visual Studio",
      "generator": "Visual Studio 18 2026",
      "toolset": "ClangCL",
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "windows-clang-x64"
        }
      }
    },
    {
      "name": "Xcode",
      "inherits": "Base",
      "generator": "Xcode",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Base",
      "hidden": true,
      "verbose": true,
      "jobs": 8
    },
    {
      "name": "Debug",
      "hidden": true,
      "inherits": "Base",
      "configuration": "Debug"
    },
    {
      "name": "Release",
      "hidden": true,
      "inherits": "Base",
      "configuration": "Release"
    },
    {
      "name": "GCC Debug",
      "inherits": "Debug",
      "configurePreset": "GCC"
    },
    {
      "name": "GCC Release",
      "inherits": "Release",
      "configurePreset": "GCC"
    },
    {
      "name": "Clang Debug",
      "inherits": "Debug",
      "configurePreset": "Clang"
    },
    {
      "name": "Clang Release",
      "inherits": "Release",
      "configurePreset": "Clang"
    },
    {
      "name": "VS_2022 Debug",
      "inherits": "Debug",
      "description": "Visual Studio 2022 multi-config Debug preset",
      "configurePreset": "VS_2022"
    },
    {
      "name": "VS_2022 Release",
      "inherits": "Release",
      "description": "Visual Studio 2022 multi-config Release preset",
      "configurePreset": "VS_2022"
    },
    {
      "name": "VS_2022_ClangCL Debug",
      "inherits": "Debug",
      "description": "Visual Studio 2022 ClangCL multi-config Debug preset",
      "configurePreset": "VS_2022_ClangCL"
    },
    {
      "name": "VS_2022_ClangCL Release",
      "inherits": "Release",
      "description": "Visual Studio 2022 ClangCL multi-config Release preset",
      "configurePreset": "VS_2022_ClangCL"
    },
    {
      "name": "VS_2026 Debug",
      "inherits": "Debug",
      "description": "Visual Studio 2026 multi-config Debug preset",
      "configurePreset": "VS_2026"
    },
    {
      "name": "VS_2026 Release",
      "inherits": "Release",
      "description": "Visual Studio 2026 multi-config Release preset",
      "configurePreset": "VS_2026"
    },
    {
      "name": "VS_2026_ClangCL Debug",
      "inherits": "Debug",
      "description": "Visual Studio 2026 ClangCL multi-config Debug preset",
      "configurePreset": "VS_2026_ClangCL"
    },
    {
      "name": "VS_2026_ClangCL Release",
      "inherits": "Release",
      "description": "Visual Studio 2026 ClangCL multi-config Release preset",
      "configurePreset": "VS_2026_ClangCL"
    },
    {
      "name": "Xcode Debug",
      "inherits": "Debug",
      "description": "Xcode multi-config Debug preset",
      "configurePreset": "Xcode"
    },
    {
      "name": "Xcode Release",
      "inherits": "Release",
      "description": "Xcode multi-config Release preset",
      "configurePreset": "Xcode"
    }
  ],
  "testPresets": [
    {
      "name": "Base",
      "hidden": true,
      "output": {
        "verbosity": "verbose"
      }
    },
    {
      "name": "Debug",
      "hidden": true,
      "inherits": "Base",
      "configuration": "Debug"
    },
    {
      "name": "Release",
      "hidden": true,
      "inherits": "Base",
      "configuration": "Release"
    },
    {
      "name": "GCC Debug",
      "inherits": "Debug",
      "configurePreset": "GCC"
    },
    {
      "name": "GCC Release",
      "inherits": "Release",
      "configurePreset": "GCC"
    },
    {
      "name": "Clang Debug",
      "inherits": "Debug",
      "configurePreset": "Clang"
    },
    {
      "name": "Clang Release",
      "inherits": "Release",
      "configurePreset": "Clang"
    },
    {
      "name": "VS_2022 Debug",
      "inherits": "Debug",
      "description": "Visual Studio 2022 multi-config Debug preset",
      "configurePreset": "VS_2022"
    },
    {
      "name": "VS_2022 Release",
      "inherits": "Release",
      "description": "Visual Studio 2022 multi-config Release preset",
      "configurePreset": "VS_2022"
    },
    {
      "name": "VS_2022_ClangCL Debug",
      "inherits": "Debug",
      "description": "Visual Studio 2022 ClangCL multi-config Debug preset",
      "configurePreset": "VS_2022_ClangCL"
    },
    {
      "name": "VS_2022_ClangCL Release",
      "inherits": "Release",
      "description": "Visual Studio 2022 ClangCL multi-config Release preset",
      "configurePreset": "VS_2022_ClangCL"
    },
    {
      "name": "VS_2026 Debug",
      "inherits": "Debug",
      "description": "Visual Studio 2026 multi-config Debug preset",
      "configurePreset": "VS_2026"
    },
    {
      "name": "VS_2026 Release",
      "inherits": "Release",
      "description": "Visual Studio 2026 multi-config Release preset",
      "configurePreset": "VS_2026"
    },
    {
      "name": "VS_2026_ClangCL Debug",
      "inherits": "Debug",
      "description": "Visual Studio 2026 ClangCL multi-config Debug preset",
      "configurePreset": "VS_2026_ClangCL"
    },
    {
      "name": "VS_2026_ClangCL Release",
      "inherits": "Release",
      "description": "Visual Studio 2026 ClangCL multi-config Release preset",
      "configurePreset": "VS_2026_ClangCL"
    },
    {
      "name": "Xcode Debug",
      "inherits": "Debug",
      "description": "Xcode multi-config Debug preset",
      "configurePreset": "Xcode"
    },
    {
      "name": "Xcode Release",
      "inherits": "Release",
      "description": "Xcode multi-config Release preset",
      "configurePreset": "Xcode"
    }
  ]
}